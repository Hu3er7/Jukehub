rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = UNIQUEMENT le compte de Hubert (19 oct. 2026, paiements). Avant, n'importe quel compte
    // connecté avait tous les droits ; avec de l'argent en jeu, il faut que ce soit exactement le sien.
    // Même courriel que ADMIN_EMAIL du serveur de paiement (functions/.env.jukehub-14c98).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'hubertplante.gd@gmail.com';
    }

    // Le répertoire complet des chansons (un seul document contenant la liste)
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Une chanson au palmarès = un document par chanson demandée ce soir.
    // 19 oct. 2026 — PAIEMENTS : "requests" = argent payé pour la chanson, EN CENTS, et "voters" =
    // argent payé par prénom. SEUL le serveur de paiement (functions/index.js, qui passe outre ces
    // règles) les augmente, une fois le paiement autorisé par Stripe. Un client ne peut donc plus
    // jamais changer ces chiffres lui-même (l'ancienne règle +1/-1 des votes est retirée).
    match /votes/{songId} {
      allow read: if true;

      // 26 oct. 2026 : "askedBy" = noms d'utilisateur des clients qui ont demandé la chanson (affichés
      // dans « Choix du public »). Un nom = texte de 1 à 15 caractères.
      function oneName(list) {
        return list is list && list.size() == 1 && list[0] is string && list[0].size() > 0 && list[0].size() <= 15;
      }

      // Première demande de la soirée : création à 0 $, avec le nom de qui la demande.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['requests', 'burned', 'title', 'artist', 'createdAt', 'askedBy']) &&
        request.resource.data.requests == 0 &&
        request.resource.data.burned == false &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        (!('askedBy' in request.resource.data) || oneName(request.resource.data.askedBy))
      );

      allow update: if isAdmin() || (
        // Réactivation d'une chanson « éteinte » (déjà jouée, revenue à 0 $) par une nouvelle demande :
        // "createdAt", "playedAt" (effacé) et "askedBy" (repart avec ce seul nom), jamais le montant.
        resource.data.get('burned', false) == false &&
        resource.data.requests == 0 &&
        resource.data.get('playedAt', null) != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt', 'playedAt', 'askedBy']) &&
        request.resource.data.playedAt == null &&
        (!('askedBy' in request.resource.data) || oneName(request.resource.data.askedBy))
      ) || (
        // Une autre personne demande une chanson déjà là : on AJOUTE seulement son nom à la liste.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['askedBy']) &&
        request.resource.data.askedBy is list &&
        request.resource.data.askedBy.size() <= 40 &&
        request.resource.data.askedBy.size() == resource.data.get('askedBy', []).size() + 1 &&
        request.resource.data.askedBy.hasAll(resource.data.get('askedBy', [])) &&
        oneName(request.resource.data.askedBy.removeAll(resource.data.get('askedBy', [])))
      );

      allow delete: if isAdmin();
    }

    // Paiements (un document par paiement Stripe) : écrits seulement par le serveur de paiement.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Réglages généraux (soirée en cours, en spectacle, afficher les montants…)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boîte de suggestions (chansons introuvables dans le répertoire) : jamais payante. Écriture
    // publique très limitée (un texte court + un prénom facultatif), lecture réservée à l'admin.
    match /specialRequests/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['text', 'createdAt', 'name']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 200 &&
        (!('name' in request.resource.data) || (
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 15
        ))
      );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Présence des clients (21 oct. 2026) : chaque téléphone écrit SON document (identifiant au hasard)
    // pour les compteurs du panneau admin. Création = les 2 heures du serveur ; ensuite seulement
    // "lastSeen", toujours l'heure du serveur (impossible de tricher sur les dates). Lecture : admin.
    match /presence/{clientId} {
      allow read: if isAdmin();
      allow create: if clientId.size() <= 40 &&
        request.resource.data.keys().hasOnly(['firstSeen', 'lastSeen']) &&
        request.resource.data.firstSeen == request.time &&
        request.resource.data.lastSeen == request.time;
      // …ou seulement "leftAt" (page fermée/quittée, 22 oct. 2026), lui aussi à l'heure du serveur
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']) &&
          request.resource.data.lastSeen == request.time) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftAt']) &&
          request.resource.data.leftAt == request.time);
      allow delete: if isAdmin();
    }

    // Chat room (26 oct. 2026) : tout le monde lit ; un client écrit un message court (200 caractères
    // max, sans lien), à l'heure du serveur, sous son nom d'utilisateur — sauf s'il a été expulsé
    // (chatBans/{son identifiant}). Personne ne modifie un message ; seul Hubert efface.
    match /chat/{msgId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'text', 'createdAt', 'clientId', 'avatar', 'song']) &&
        // song facultatif (29 oct. 2026) : titre de la chanson pour un message écrit sous une chanson
        (!('song' in request.resource.data) ||
          (request.resource.data.song is string && request.resource.data.song.size() > 0 && request.resource.data.song.size() <= 200)) &&
        // avatar facultatif (27 oct. 2026) : un des identifiants de CHAT_AVATARS dans index.html
        (!('avatar' in request.resource.data) ||
          request.resource.data.avatar in ['bear', 'robot', 'alien', 'ghost', 'skull', 'flower', 'heart', 'star', 'peace', 'leaf']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 15 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200 &&
        !request.resource.data.text.matches('(?i).*(https?://|www[.]).*') &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.clientId is string && request.resource.data.clientId.size() >= 8 && request.resource.data.clientId.size() <= 40 &&
        !exists(/databases/$(database)/documents/chatBans/$(request.resource.data.clientId));
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Expulsés du chat (Hubert seulement) ; un client peut seulement lire SON propre document
    match /chatBans/{clientId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Compteur cumulatif de demandes par artiste (mis à jour par chaque client à chaque demande)
    match /stats/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
